<Window x:Class="PE.Exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PE.Exam"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        
        <DataGrid x:Name="FruitsDataGrid" HorizontalAlignment="Left" Height="252" Margin="41,108,0,0" VerticalAlignment="Top" Width="591" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã TC" Width="50" Binding="{Binding Id }" />
                <DataGridTextColumn Header="Tên trái cây" Width="100" Binding="{Binding Name }" />
                <DataGridTextColumn Header="Chi tiết" Width="150" Binding="{Binding Description }" />
                <DataGridTextColumn Header="Giá" Width="80" Binding="{Binding Price }" />
                <DataGridTextColumn Header="CateId" Width="50" Binding="{Binding CategoryId }" />
                <DataGridTextColumn Header="Phân loại" Width="120" Binding="{Binding Category.Name }" />
            </DataGrid.Columns>
        </DataGrid>
        
        <Button x:Name="CreateButton" Content="Create" HorizontalAlignment="Left" Height="43" FontSize="20" FontWeight="ExtraBold" Margin="652,87,0,0" VerticalAlignment="Top" Width="97" Click="CreateButton_Click"/>
        <Button x:Name="EditButton" Content="Edit" HorizontalAlignment="Left" Height="43" FontSize="20" FontWeight="ExtraBold" Margin="652,162,0,0" VerticalAlignment="Top" Width="97" Click="EditButton_Click"/>
        <Button x:Name="DeleteButton" Content="Delete" HorizontalAlignment="Left" Height="43" FontSize="20" FontWeight="ExtraBold" Margin="652,241,0,0" VerticalAlignment="Top" Width="97" Click="DeleteButton_Click"/>
        <Button x:Name="QuitButton" Content="Quit" HorizontalAlignment="Left" Height="43" FontSize="20" FontWeight="ExtraBold" Margin="652,333,0,0" VerticalAlignment="Top" Width="97"/>


        <ComboBox x:Name="StatusComboBox"  HorizontalAlignment="Left" Margin="628,22,0,0" VerticalAlignment="Top" Width="139" Height="29" />

        <Label Content="Keyword:" HorizontalAlignment="Left" Height="35" Margin="41,29,0,0" VerticalAlignment="Top" Width="121" FontWeight="Bold" FontSize="20" />

        <TextBox x:Name="SearchTextBox" HorizontalAlignment="Left" Height="43" Margin="153,25,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="230"
            FontSize="20" FontWeight="Bold" Foreground="#8b0000"/>
        <Button x:Name="SearchButton" Content="Search" HorizontalAlignment="Left" Height="48" Margin="417,22,0,0" VerticalAlignment="Top" Width="119"
            FontSize="20" FontWeight="Bold" Background="#9b111e" 
            Foreground="#ffff00" />

        
    </Grid>
</Window>
