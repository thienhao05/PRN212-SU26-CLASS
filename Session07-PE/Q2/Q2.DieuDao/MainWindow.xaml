<Window x:Class="Q2.DieuDao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Q2.DieuDao"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="FruitDataGrid" HorizontalAlignment="Left" Height="129" Margin="51,43,0,0" VerticalAlignment="Top" Width="367" />

        <TextBox x:Name="IdTextBox" HorizontalAlignment="Left" Height="24" Margin="51,200,0,0" TextWrapping="Wrap" Text="Id" VerticalAlignment="Top" Width="49"/>

        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Height="24" Margin="125,200,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" Width="118"/>

        <TextBox x:Name="DescTextBox" HorizontalAlignment="Left" Height="24" Margin="274,200,0,0" TextWrapping="Wrap" Text="Desc" VerticalAlignment="Top" Width="118"/>

        <TextBox x:Name="PriceTextBox" HorizontalAlignment="Left" Height="24" Margin="417,200,0,0" TextWrapping="Wrap" Text="Price" VerticalAlignment="Top" Width="72"/>

        <ComboBox x:Name="CatesComboBox" HorizontalAlignment="Left" Height="24" Margin="512,200,0,0" VerticalAlignment="Top" Width="127"/>

        <Button x:Name="NewButton" Content="New" HorizontalAlignment="Left" Height="39" Margin="51,251,0,0" VerticalAlignment="Top" Width="89"/>
        
        <Button x:Name="EditButton" Content="Edit" HorizontalAlignment="Left" Height="39" Margin="184,251,0,0" VerticalAlignment="Top" Width="89"/>
        
        


    </Grid>
</Window>
