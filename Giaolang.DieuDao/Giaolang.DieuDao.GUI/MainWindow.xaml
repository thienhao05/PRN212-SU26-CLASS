<Window x:Class="Giaolang.DieuDao.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Giaolang.DieuDao.GUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <DataGrid x:Name="FruitsDataGrid" HorizontalAlignment="Left" Height="252" Margin="28,140,0,0" VerticalAlignment="Top" Width="591" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã TC" Width="50" Binding="{Binding Id }" />
                <DataGridTextColumn Header="Tên trái cây" Width="100" Binding="{Binding Name }" />
                <DataGridTextColumn Header="Chi tiết" Width="150" Binding="{Binding Description }" />
                <DataGridTextColumn Header="Giá" Width="80" Binding="{Binding Price }" />
                <DataGridTextColumn Header="CateId" Width="50" Binding="{Binding CategoryId }" />
                <DataGridTextColumn Header="Phân loại" Width="120" Binding="{Binding Category.Name }" />
            </DataGrid.Columns>

        </DataGrid>
        <Button x:Name="CreateButton" Content="Create" HorizontalAlignment="Left" Height="48" Margin="648,67,0,0" VerticalAlignment="Top" Width="119" FontSize="20" FontWeight="ExtraBold" Click="CreateButton_Click"/>
        <Button x:Name="EditButton" Content="Edit" HorizontalAlignment="Left" Height="48" Margin="648,134,0,0" VerticalAlignment="Top" Width="119" FontSize="20" FontWeight="ExtraBold" Click="EditButton_Click"/>
        <Button x:Name="DeleteButton" Content="Delete" HorizontalAlignment="Left" Height="48" Margin="648,207,0,0" VerticalAlignment="Top" Width="119" FontSize="20" FontWeight="ExtraBold" Click="DeleteButton_Click"/>
        <Button x:Name="QuitButton" Content="Quit" HorizontalAlignment="Left" Height="48" Margin="648,325,0,0" VerticalAlignment="Top" Width="119" FontSize="20" FontWeight="ExtraBold" Click="DeleteButton_Click"/>
        <ComboBox x:Name="StatusComboBox"  HorizontalAlignment="Left" Margin="628,22,0,0" VerticalAlignment="Top" Width="139" Height="29" />
        <Label Content="Keyword:" HorizontalAlignment="Left" Height="44" Margin="29,69,0,0" VerticalAlignment="Top" Width="110"
            FontWeight="Bold" FontSize="20"
               />
        <TextBox x:Name="SearchTextBox" HorizontalAlignment="Left" Height="44" Margin="139,67,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="230"
            FontSize="20" FontWeight="Bold" Foreground="#8b0000"
                 />
        <Button x:Name="SearchButton" Content="Search" HorizontalAlignment="Left" Height="48" Margin="400,65,0,0" VerticalAlignment="Top" Width="119"
            FontSize="20" FontWeight="Bold" Background="#9b111e" 
            Foreground="#ffff00" Click="SearchButton_Click"
                />

    </Grid>
</Window>
