<Window x:Class="Giaolang.DieuDao.GUI.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Giaolang.DieuDao.GUI"
        mc:Ignorable="d"
        Title="DetailWindow" Height="509" Width="800" 
        Background="#d7837f"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="378" Margin="27,82,0,0" Stroke="Black" VerticalAlignment="Top" Width="599" Fill="#ff6e4a" RadiusX="10" RadiusY="10"/>

        <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Left" Height="48" Margin="657,82,0,0" VerticalAlignment="Top" Width="119"
              FontSize="20" FontWeight="Bold" Background="#9b111e" 
                Foreground="#ffff00" Click="SaveButton_Click"
                />

        <Label Content="View fruit" HorizontalAlignment="Left" Height="66" Margin="27,11,0,0" VerticalAlignment="Top" Width="707"
          FontSize="40" FontWeight="Bold" Foreground="#ffff00"
               x:Name="FormModeLabel"
               />

        <Label Content="Id:" HorizontalAlignment="Left" Height="44" Margin="57,108,0,0" VerticalAlignment="Top" Width="52"
               FontWeight="Bold" FontSize="20"
               />

        <TextBox x:Name="IdTextBox" HorizontalAlignment="Left" Height="44" Margin="198,108,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="230"
              FontSize="20" FontWeight="Bold" Foreground="#8b0000"
                 />

        <ComboBox x:Name="CateComboBox" HorizontalAlignment="Left" Height="38" Margin="198,386,0,0" VerticalAlignment="Top" Width="330"
                  FontSize="20" FontWeight="Bold"
                  />
        <Label Content="Name:" HorizontalAlignment="Left" Height="44" Margin="57,173,0,0" VerticalAlignment="Top" Width="73"
            FontWeight="Bold" FontSize="20"
               />
        <Label Content="Description:" HorizontalAlignment="Left" Height="44" Margin="57,241,0,0" VerticalAlignment="Top" Width="128"
            FontWeight="Bold" FontSize="20"
               />
        <Label Content="Price:" HorizontalAlignment="Left" Height="44" Margin="57,316,0,0" VerticalAlignment="Top" Width="73"
            FontWeight="Bold" FontSize="20"
               />
        <Label Content="Category:" HorizontalAlignment="Left" Height="44" Margin="57,386,0,0" VerticalAlignment="Top" Width="128"
            FontWeight="Bold" FontSize="20"
               />
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Height="44" Margin="198,173,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="230"
            FontSize="20" FontWeight="Bold" Foreground="#8b0000"
                 />
        <TextBox x:Name="DescTextBox" HorizontalAlignment="Left" Height="44" Margin="198,245,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="383"
            FontSize="20" FontWeight="Bold" Foreground="#8b0000"
                 />
        <TextBox x:Name="PriceTextBox" HorizontalAlignment="Left" Height="44" Margin="198,316,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="148"
            FontSize="20" FontWeight="Bold" Foreground="#8b0000"
                 />
        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Height="48" Margin="657,147,0,0" VerticalAlignment="Top" Width="119"
            FontSize="20" FontWeight="Bold" Background="#9b111e" 
            Foreground="#ffff00" Click="CancelButton_Click"
                />

    </Grid>
</Window>
